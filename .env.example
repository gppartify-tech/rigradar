# Copy to .env and adjust. Every value has a sensible default, so only the
# first block really matters.

# --- Change these -------------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Admin account created on start-up (can trigger scrapes from /admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- AI assistant (optional) -----------------------------------------------------
# Without a key the assistant runs in offline (rule-based) mode.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# low | medium | high - how much the model thinks before answering
CHAT_EFFORT=low

# --- Demo data -----------------------------------------------------------------
# Load the bundled real price snapshot into an empty catalog (great for demos)
SEED_SAMPLE_DATA=true
# Demo users (sami / lina / omar, password demo12345) with marketplace listings.
# NEVER enable on a public server.
SEED_DEMO_USERS=true

# --- Scraping --------------------------------------------------------------------
SCRAPE_INTERVAL_HOURS=6
SCRAPE_DELAY_SECONDS=2.5
SCRAPER_MAX_PAGES_PER_CATEGORY=15

# --- E-mail ------------------------------------------------------------------------
# docker compose uses the built-in Mailpit test inbox (http://localhost:8025).
# For real e-mails, e.g. Gmail with an app password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=RigRadar <you@gmail.com>
